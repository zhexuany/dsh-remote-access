#!/bin/sh
# dsh-remote-access — installer wrapper.
#
# Runs bin/install.mjs through the DSH Desktop app's own Node runtime
# (`ELECTRON_RUN_AS_NODE=1`) because the app does not require a system node.
set -e

SELF_DIR=$(cd "$(dirname "$0")" && pwd)

APP="${DSH_NEXT_APP:-}"
if [ -z "$APP" ]; then
  for candidate in "/Applications/DSH NEXT.app" "$HOME/Applications/DSH NEXT.app"; do
    if [ -x "$candidate/Contents/MacOS/DSH NEXT" ]; then
      APP="$candidate"
      break
    fi
  done
fi

if [ -n "$APP" ] && [ -x "$APP/Contents/MacOS/DSH NEXT" ]; then
  exec env ELECTRON_RUN_AS_NODE=1 "$APP/Contents/MacOS/DSH NEXT" "$SELF_DIR/install.mjs" "$@"
fi

if command -v node >/dev/null 2>&1; then
  exec node "$SELF_DIR/install.mjs" "$@"
fi

echo "dsh-remote-access: no DSH Desktop app and no node runtime found (set DSH_NEXT_APP to the .app path)" >&2
exit 127
